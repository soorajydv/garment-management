# Server
PORT=4000
NODE_ENV=development
# Comma separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ss_textiles

# Auth - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where uploaded artwork / reference files are stored (private, served only through the API)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
